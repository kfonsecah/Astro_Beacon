{
  "info": {
    "name": "AstroBeacon API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "token", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": ["if (!pm.environment.get('token')) { console.log('⚠️ No token set - set token after login') }"],
        "type": "text/javascript"
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"test@example.com\",\"password\":\"Test1234!\"}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"test@example.com\",\"password\":\"Test1234!\"}"
            }
          }
        },
        {
          "name": "Login (wrong password)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"test@example.com\",\"password\":\"WrongPassword123!\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Resources",
      "item": [
        {
          "name": "Create Resource",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/resources",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Oxigeno\",\"category\":\"oxigeno\",\"amount\":100}"
            }
          }
        },
        {
          "name": "List Resources",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/resources",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "Get Resource by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/resources/:id",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "Update Resource",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/resources/:id",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"amount\":50}"
            }
          }
        },
        {
          "name": "Resource Alerts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/resources/alerts",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "Delete Resource",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/resources/:id",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" ]
          }
        },
        {
          "name": "List Resources (NO TOKEN)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/resources"
          }
        },
        {
          "name": "List Resources (INVALID TOKEN)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/resources",
            "header": [ { "key": "Authorization", "value": "Bearer invalid-token" } ]
          }
        }
      ]
    },
    {
      "name": "Species",
      "item": [
        {
          "name": "Create Species",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/species",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Oak\",\"scientificName\":\"Quercus\",\"classification\":\"planta\",\"status\":\"observado\"}"
            }
          }
        },
        {
          "name": "List Species",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/species",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "Get Species by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/species/:id",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "Update Species",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/species/:id",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"status\":\"catalogado\"}" }
          }
        },
        {
          "name": "Delete Species",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/species/:id",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        }
      ]
    },
    {
      "name": "Logbook",
      "item": [
        {
          "name": "Create Entry",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/logbook",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Avistamiento\",\"content\":\"Test observation\",\"observationType\":\"avistamiento\"}"
            }
          }
        },
        {
          "name": "List Entries",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/logbook",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "Get Entry by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/logbook/:id",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "Update Entry",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/logbook/:id",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"content\":\"Updated content\"}" }
          }
        },
        {
          "name": "Delete Entry",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/logbook/:id",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        }
      ]
    },
    {
      "name": "Astronaut",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/astronaut",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/astronaut",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Test Astronaut\",\"rank\":\"Commander\"}"
            }
          }
        },
        {
          "name": "Get Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/astronaut/stats",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        }
      ]
    },
    {
      "name": "Trips",
      "item": [
        {
          "name": "Create Trip",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/trips",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Mission 1\",\"plannedDuration\":60}"
            }
          }
        },
        {
          "name": "List Trips",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/trips",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "Get Trip by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/trips/:id",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "Start Trip",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/trips/:id/start",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "End Trip",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/trips/:id/end",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "O2 Adjustment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/trips/:id/o2/adjustment",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"amount\":1}" }
          }
        },
        {
          "name": "Delete Trip",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/trips/:id",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        }
      ]
    },
    {
      "name": "Supplies",
      "item": [
        {
          "name": "Create Supply",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/supplies",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Food Rations\",\"location\":{\"lat\":40.7128,\"lng\":-74.006}}"
            }
          }
        },
        {
          "name": "List Supplies",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/supplies",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "Get Nearby",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/supplies/nearby?lat=40&lng=-74&radius=100000",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "Get Supply by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/supplies/:id",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "Update Supply",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/supplies/:id",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"Updated\"}" }
          }
        },
        {
          "name": "Collect Supply",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/supplies/:id/collect",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        },
        {
          "name": "Delete Supply",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/supplies/:id",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        }
      ]
    }
  ]
}